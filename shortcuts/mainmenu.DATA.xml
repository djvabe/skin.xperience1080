<?xml version="1.0" encoding="UTF-8"?>
<!--
   Xperience1080 "2026" remake — shipped DEFAULT main menu for script.skinshortcuts.
   Format matches script.skinshortcuts' own reference DATA files (required fields:
   label, label2, icon, thumb, action). <defaultID> is set explicitly so the skin can
   bind per-hub widgets language-independently (Container(9000).ListItem.Property(defaultID)).
   label2 (shortcut "type") uses skinshortcuts' own string 32034.
   Per-hub widget CONTENT is provided by the skin via defaultID-keyed variables
   (see Includes_Home2026.xml), so it survives skinshortcuts' buildxml regeneration.
-->
<shortcuts>
    <shortcut>
        <label>32001</label>
        <label2>32034</label2>
        <icon>special://skin/media/windows/home/icons/appearance.png</icon>
        <thumb />
        <action>ActivateWindow(Home)</action>
        <defaultID>home</defaultID>
    </shortcut>
    <shortcut>
        <label>32002</label>
        <label2>32034</label2>
        <icon>special://skin/media/windows/home/icons/video.png</icon>
        <thumb />
        <action>ActivateWindow(Videos,videodb://movies/titles/,return)</action>
        <defaultID>movies</defaultID>
    </shortcut>
    <shortcut>
        <label>32003</label>
        <label2>32034</label2>
        <icon>special://skin/media/windows/home/icons/tvshows.png</icon>
        <thumb />
        <action>ActivateWindow(Videos,videodb://tvshows/titles/,return)</action>
        <defaultID>series</defaultID>
    </shortcut>
    <shortcut>
        <label>32004</label>
        <label2>32034</label2>
        <icon>special://skin/media/windows/home/icons/epg.png</icon>
        <thumb />
        <action>ActivateWindow(TVChannels)</action>
        <defaultID>live</defaultID>
    </shortcut>
    <shortcut>
        <label>32005</label>
        <label2>32034</label2>
        <icon>special://skin/media/windows/home/icons/addons.png</icon>
        <thumb />
        <action>ActivateWindow(Videos,addons://sources/video/,return)</action>
        <defaultID>addons</defaultID>
    </shortcut>
</shortcuts>
