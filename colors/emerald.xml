<?xml version="1.0" encoding="UTF-8"?>
<!--
   Xperience1080 "2026" remake — colour theme (Emerald accent).
   Existing colour NAMES are preserved so the 122 legacy windows keep working;
   accent-tinted names are re-pointed to the new design accent (#5BA8FF).
   New 2026 design tokens are added at the bottom (bg/text/glass/category/brand/accent).
   Sibling files (amber/emerald/purple/coral.xml) are accent variants selectable
   via Settings > Interface > Skin > Colours.
-->
<colors>
        <!-- Base neutrals -->
        <color name="black">FF000000</color>
        <color name="white">FFFFFFFF</color>
        <color name="brightred">FFC80000</color>
        <color name="grey">FFC0C2C2</color>
        <color name="red">FFCE4421</color>
        <color name="midgrey">FF686868</color>
        <color name="bluegrey">ffC6C6C8</color>
        <color name="darkgrey">FF2C2C2C</color>
        <color name="darkgrey2">FF666769</color>
        <color name="lightgrey">FFDDDDDD</color>

        <!-- Accent-tinted legacy names re-pointed to the 2026 accent (#5BA8FF) -->
        <color name="blue">FF4FD0A0</color>
        <color name="homelabelbig">FFF5F6F8</color>
        <color name="homelabelsmall">FF4FD0A0</color>
        <color name="greyblue">FF7B8089</color>
        <color name="listwhite">FFF5F6F8</color>
        <color name="guideblue">FF4FD0A0</color>
        <color name="guidebutton">FF4FD0A0</color>
        <color name="MenuBlue">FF4FD0A0</color>
        <color name="MenuGrey">CC1A1D24</color>
        <color name="KeyboardGrey">991A1D24</color>
        <color name="SettingsBlue">FF4FD0A0</color>
        <color name="DialogSelected">FF4FD0A0</color>
        <color name="SelectedRed">FFE10101</color>
        <color name="SelectedColor">FF4FD0A0</color>
        <color name="SelectedBlue">FF4FD0A0</color>

        <!-- White alpha ramp (legacy) -->
        <color name="77white">77FFFFFF</color>
        <color name="aawhite">AAFFFFFF</color>
        <color name="bbwhite">BBFFFFFF</color>
        <color name="ddwhite">DDFFFFFF</color>
        <color name="eewhite">EEFFFFFF</color>

        <!-- ===================== 2026 design tokens ===================== -->
        <!-- Surfaces -->
        <color name="bg">FF0D0F14</color>        <!-- app background -->
        <color name="bg2">FF14171D</color>       <!-- raised surface -->
        <color name="bg3">FF1A1D24</color>       <!-- raised surface 2 -->
        <color name="scrim">CC06080C</color>     <!-- fanart scrim -->
        <color name="scrimStrong">E60A0C10</color>

        <!-- Text -->
        <color name="text">FFF5F6F8</color>      <!-- primary -->
        <color name="dim">FFB0B4BD</color>       <!-- secondary -->
        <color name="faint">FF7B8089</color>     <!-- tertiary / labels -->
        <color name="textShadow">CC000000</color>

        <!-- Glass -->
        <color name="glass">10FFFFFF</color>     <!-- ~6% white fill -->
        <color name="glassHi">21FFFFFF</color>   <!-- ~13% white border -->
        <color name="glassLo">0AFFFFFF</color>

        <!-- Accent (default = blue). Accent variants override these in sibling files. -->
        <color name="accent">FF4FD0A0</color>
        <color name="accentDim">B34FD0A0</color>
        <color name="accentGlow">664FD0A0</color>
        <color name="onaccent">FF06140E</color>

        <!-- Category tile colours -->
        <color name="catMovies">FF2F6DB0</color>
        <color name="catMoviesDk">FF173658</color>
        <color name="catSeries">FF2F8F5B</color>
        <color name="catSeriesDk">FF17472D</color>
        <color name="catLive">FFB0402F</color>
        <color name="catLiveDk">FF582017</color>
        <color name="catAddons">FF7A3FB0</color>
        <color name="catAddonsDk">FF3D1F58</color>

        <!-- Add-on brand tints -->
        <color name="brandJellyfin">FFA24BFF</color>
        <color name="brandIPTV">FF3DBE8B</color>
        <color name="brandYouTube">FFFF4E45</color>
        <color name="brandTwitch">FF9147FF</color>
        <color name="brandPlex">FFE5A00D</color>
        <color name="brandSpotify">FF1DB954</color>

        <!-- Status / utility -->
        <color name="rec">FFFF4E45</color>
        <color name="ratingStar">FFF5B454</color>
        <color name="progressBg">33FFFFFF</color>
</colors>
