<?xml version="1.0" encoding="UTF-8"?>
<!--
   SEED of the script.skinshortcuts generated menu include.
   script.skinshortcuts OVERWRITES this on first Home load (type=buildxml), rebuilding
   it from the user's menu (seeded by shortcuts/mainmenu.DATA.xml). Shipping this seed
   makes the menu render immediately on first launch. Items expose the defaultID
   property; per-hub widget content is bound in the skin via defaultID-keyed variables
   (Includes_Home2026.xml), so it works both before and after buildxml.
-->
<includes>
    <include name="skinshortcuts-mainmenu">
        <item>
            <label>$LOCALIZE[32001]</label>
            <icon>special://skin/media/windows/home/icons/appearance.png</icon>
            <onclick>ActivateWindow(Home)</onclick>
            <property name="defaultID">home</property>
            <property name="labelID">home</property>
        </item>
        <item>
            <label>$LOCALIZE[32002]</label>
            <icon>special://skin/media/windows/home/icons/video.png</icon>
            <onclick>ActivateWindow(Videos,videodb://movies/titles/,return)</onclick>
            <property name="defaultID">movies</property>
            <property name="labelID">movies</property>
        </item>
        <item>
            <label>$LOCALIZE[32003]</label>
            <icon>special://skin/media/windows/home/icons/tvshows.png</icon>
            <onclick>ActivateWindow(Videos,videodb://tvshows/titles/,return)</onclick>
            <property name="defaultID">series</property>
            <property name="labelID">series</property>
        </item>
        <item>
            <label>$LOCALIZE[32004]</label>
            <icon>special://skin/media/windows/home/icons/epg.png</icon>
            <onclick>ActivateWindow(TVChannels)</onclick>
            <property name="defaultID">live</property>
            <property name="labelID">live</property>
        </item>
        <item>
            <label>$LOCALIZE[32005]</label>
            <icon>special://skin/media/windows/home/icons/addons.png</icon>
            <onclick>ActivateWindow(Videos,addons://sources/video/,return)</onclick>
            <property name="defaultID">addons</property>
            <property name="labelID">addons</property>
        </item>
    </include>
</includes>
