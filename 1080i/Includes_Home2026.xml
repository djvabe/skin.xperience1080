<?xml version="1.0" encoding="UTF-8"?>
<!--
   Xperience1080 "2026" remake — includes for the new Home (Tiles) window.

   Per-hub widget content is driven by the focused main-menu item's defaultID
   (Container(9000).ListItem.Property(defaultID)) via the Widget2026.* variables below.
   This is language-independent and survives script.skinshortcuts' buildxml regeneration
   (it does not rely on skinshortcuts widget properties). Three widget slots per hub:
   primary (featured centre), .1 (right slot 1), .2 (right slot 2).
-->
<includes>

    <!-- ============ per-hub widget PATHS ============ -->
    <variable name="Widget2026.Path">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">videodb://recentlyaddedmovies/</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),movies)">videodb://recentlyaddedmovies/</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),series)">videodb://recentlyaddedepisodes/</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),live)">pvr://channels/tv/*</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),addons)">addons://sources/video/</value>
        <value>videodb://recentlyaddedmovies/</value>
    </variable>
    <variable name="Widget2026.Path1">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">videodb://inprogresstvshows/</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),movies)">videodb://movies/titles/</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),series)">videodb://tvshows/titles/</value>
        <value></value>
    </variable>
    <variable name="Widget2026.Path2">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">videodb://recentlyaddedepisodes/</value>
        <value></value>
    </variable>

    <!-- ============ per-hub widget TARGETS ============ -->
    <variable name="Widget2026.Target">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),live)">pvr</value>
        <value>videos</value>
    </variable>

    <!-- ============ per-hub widget NAMES ============ -->
    <variable name="Widget2026.Name">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">$LOCALIZE[20386]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),movies)">$LOCALIZE[20386]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),series)">$LOCALIZE[20387]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),live)">$LOCALIZE[19019]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),addons)">$LOCALIZE[1037]</value>
        <value>$LOCALIZE[20386]</value>
    </variable>
    <variable name="Widget2026.Name1">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">$LOCALIZE[626]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),movies)">$LOCALIZE[342]</value>
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),series)">$LOCALIZE[20343]</value>
        <value></value>
    </variable>
    <variable name="Widget2026.Name2">
        <value condition="String.IsEqual(Container(9000).ListItem.Property(defaultID),home)">$LOCALIZE[20387]</value>
        <value></value>
    </variable>

    <!-- ============ right-column widget slot ============ -->
    <include name="HomeWidgetSlot2026">
        <param name="id" default="9201" />
        <param name="top" default="150" />
        <param name="pathvar" default="Widget2026.Path1" />
        <param name="namevar" default="Widget2026.Name1" />
        <param name="onup" default="9000" />
        <param name="ondown" default="9300" />
        <definition>
            <control type="group">
                <left>1474</left>
                <top>$PARAM[top]</top>
                <width>382</width>
                <height>232</height>

                <control type="list" id="$PARAM[id]">
                    <left>0</left><top>0</top><width>382</width><height>232</height>
                    <focusposition>0</focusposition>
                    <onup>$PARAM[onup]</onup>
                    <ondown>$PARAM[ondown]</ondown>
                    <onleft>9100</onleft>
                    <onright>$PARAM[id]</onright>
                    <itemlayout width="382" height="232">
                        <control type="image">
                            <left>0</left><top>0</top><width>382</width><height>232</height>
                            <aspectratio>scale</aspectratio>
                            <texture fallback="special://skin/media/windows/common/darkgrey.png">$INFO[ListItem.Art(thumb)]</texture>
                        </control>
                        <control type="image">
                            <left>0</left><top>0</top><width>382</width><height>232</height>
                            <texture>special://skin/media/windows/common/black.png</texture>
                            <colordiffuse>scrim</colordiffuse>
                        </control>
                    </itemlayout>
                    <focusedlayout width="382" height="232">
                        <control type="image">
                            <left>0</left><top>0</top><width>382</width><height>232</height>
                            <aspectratio>scale</aspectratio>
                            <texture fallback="special://skin/media/windows/common/darkgrey.png">$INFO[ListItem.Art(thumb)]</texture>
                        </control>
                        <control type="image">
                            <left>0</left><top>0</top><width>382</width><height>232</height>
                            <texture>special://skin/media/windows/common/black.png</texture>
                            <colordiffuse>scrim</colordiffuse>
                        </control>
                        <control type="image">
                            <left>0</left><top>0</top><width>382</width><height>232</height>
                            <texture border="2">special://skin/media/windows/home/tile-fo.png</texture>
                            <visible>Control.HasFocus($PARAM[id])</visible>
                        </control>
                    </focusedlayout>
                    <content target="$VAR[Widget2026.Target]" limit="1">$VAR[$PARAM[pathvar]]</content>
                </control>

                <control type="label">
                    <left>16</left><top>166</top><width>350</width><height>30</height>
                    <font>Font-Label-18</font>
                    <textcolor>text</textcolor>
                    <label>$VAR[$PARAM[namevar]]</label>
                    <visible>!String.IsEmpty($VAR[$PARAM[pathvar]])</visible>
                </control>
                <control type="label">
                    <left>16</left><top>196</top><width>350</width><height>26</height>
                    <font>Font-Body-17</font>
                    <textcolor>dim</textcolor>
                    <label>$INFO[Container($PARAM[id]).NumItems] $LOCALIZE[32024]</label>
                    <visible>!String.IsEmpty($VAR[$PARAM[pathvar]])</visible>
                </control>

                <control type="label">
                    <left>0</left><top>96</top><width>382</width><height>40</height>
                    <font>Font-Label-18</font>
                    <textcolor>faint</textcolor>
                    <label>+ $LOCALIZE[32021]</label>
                    <align>center</align>
                    <visible>String.IsEmpty($VAR[$PARAM[pathvar]])</visible>
                </control>
            </control>
        </definition>
    </include>

</includes>
